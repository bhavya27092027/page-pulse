# ===== Page Pulse Backend Environment =====
# Copy to .env and adjust as needed. Never commit real secrets.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins ("*" allows any)
CORS_ORIGIN=http://localhost:5173,https://page-pulse.vercel.app

# Audit behaviour
AUDIT_TIMEOUT_MS=5000
MAX_CONCURRENT_AUDITS=10
CACHE_TTL_SECONDS=600
HISTORY_LIMIT=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=100
