# Build configuration for Vercel — frontend.
# The frontend lives at the repo root; the backend is in /server and deploys
# to Render separately.

[build]
  command = "npm run build"
  output_directory = "dist"

# SPA rewrites so client-side routes (e.g. /404) resolve to index.html.
[[routes]]
  pattern = "/*"
  destination = "/index.html"
  status = 200

[env]
  # Set VITE_API_URL in the Vercel project settings to your Render backend URL.
  # Example: VITE_API_URL = "https://page-pulse-api.onrender.com"
  # VITE_API_URL = ""
